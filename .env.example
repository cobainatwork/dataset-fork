# ============================================================
# Easy Dataset Environment Variables
# ------------------------------------------------------------
# 1. 複製此檔為 .env 後填入實際值。.env 已被 .gitignore 排除，
#    不會進入 git history。
# 2. 新增變數時，請同步更新此 .example 檔與 /src/env.js（若存在）。
# 3. 切勿在此檔填入真實密鑰；僅作為變數清單與註解。
# ============================================================

# --- Prisma 資料庫連線 ----------------------------------------
# 必填。Prisma 用此 URL 決定資料庫位置與類型。
# 預設為本機 SQLite，路徑相對於 prisma/schema.prisma。
# Docker 容器內保持相同預設，由 docker-compose 將 prisma/
# 目錄 mount 進去。
# 參考：https://www.prisma.io/docs/reference/database-reference/connection-urls
DATABASE_URL="file:./db.sqlite"

# --- 本機資料目錄 ---------------------------------------------
# 可選。應用使用的本機資料夾路徑（上傳檔、暫存、本地 DB 等）。
# docker-compose.yml 預設將 ./local-db 目錄 mount 至
# /app/local-db；若調整此值，需同步更新 compose volumes。
LOCAL_DB_PATH=./local-db

# --- 應用埠號 -------------------------------------------------
# 可選。Next.js 伺服器埠號，預設 1717。
# Dockerfile EXPOSE 與 docker-compose ports 均假設此預設值；
# 改動時三處需同步。
PORT=1717

# ============================================================
# 不在此處設定的變數（避免誤用）
# ------------------------------------------------------------
# NODE_ENV  由執行環境決定：
#             - 本機開發：next dev → development
#             - 本機建置：next build && next start → production
#             - Docker：Dockerfile 內已 ENV NODE_ENV=production
# INITED    Runtime 旗標，由 lib/services/tasks/recovery.js
#             自行設定，請勿手動填入。
# ============================================================
