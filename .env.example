# ============================================================
# Easy Dataset Environment Variables
# ------------------------------------------------------------
# 1. 複製此檔為 .env 後填入實際值。.env 已被 .gitignore 排除，
#    不會進入 git history。
# 2. 新增變數時，請同步更新此 .example 檔。
# 3. 切勿在此檔填入真實密鑰；僅作為變數清單與註解。
# ============================================================

# --- Prisma 資料庫連線 ----------------------------------------
# Container 內透過 compose 服務名「postgres」解析。
# 密碼必須與 POSTGRES_PASSWORD 一致。
DATABASE_URL="postgresql://easy:CHANGE_ME@postgres:5432/easy_dataset?schema=public"

# --- PostgreSQL 初始化（postgres service 使用）---------------
# 首次啟動 postgres container 時用這三個變數建立 super user / DB。
POSTGRES_USER=easy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=easy_dataset

# --- 本機資料目錄 ---------------------------------------------
# 應用使用的本機資料夾路徑（上傳檔、暫存）。
LOCAL_DB_PATH=./local-db

# --- 應用埠號 -------------------------------------------------
PORT=1717

# ============================================================
# 不在此處設定的變數（避免誤用）
# ------------------------------------------------------------
# NODE_ENV  Dockerfile 內已 ENV NODE_ENV=production
# INITED    Runtime 旗標，由 lib/services/tasks/recovery.js 自設
# ============================================================
